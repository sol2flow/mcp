# Matches .prettierrc.json; Prettier formats the files, this keeps editors in line before it runs.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# two trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

{
  "name": "@sol2flow/mcp",
  "version": "0.0.0-development",
  "description": "MCP server for sol2flow: lets AI assistants read and change your tasks through the sol2flow REST API",
  "license": "MIT",
  "type": "module",
  "mcpName": "com.sol2flow/mcp",
  "bin": {
    "sol2flow-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sol2flow/mcp.git"
  },
  "homepage": "https://docs.sol2flow.com/docs/integrations/mcp",
  "bugs": "https://github.com/sol2flow/mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sol2flow",
    "kanban",
    "tasks"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "prepack": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project protocol --project contract",
    "test:integration": "vitest run --project integration",
    "openapi:types": "node scripts/openapi-types.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@sentry/node": "11.3.0",
    "@types/node": "22.20.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "pino": "10.3.1",
    "prettier": "3.9.9",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
